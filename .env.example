# Copy to .env for local development (never commit real secrets).

# --- Medical analyze API (browser) ---
# Base URL only (no trailing slash). POST multipart `files` → /api/v1/analyze (see src/config/analyzeApi.js)
NEXT_PUBLIC_ANALYZE_API_BASE_URL=https://medical-analysis-backend-2p3fwh332a-uc.a.run.app

# --- Firebase Authentication (med-docs project) ---
# Firebase Console → Project settings → Your apps → Web app → copy apiKey
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=med-docs-1fe8d
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=med-docs-1fe8d.firebaseapp.com
# Optional fallback if Firebase session is unavailable (local backend dev only)
# NEXT_PUBLIC_API_AUTH_TOKEN=dummy_token

# Optional Bearer for the analyze API (exposed to the browser — use only if acceptable for your threat model).
# NEXT_PUBLIC_ANALYZE_API_KEY=

# --- Legacy demo auth (fallback when Firebase is not configured) ---
MEDDOCS_AUTH_SECRET=
MEDDOCS_LOGIN_EMAIL=
MEDDOCS_LOGIN_PASSWORD=
